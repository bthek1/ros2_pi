# colcon
build/
install/
log/

# model weights — fetched, not committed (see docs/info/setup.md)
models/
*.onnx
*.engine

# the calibrator's own frame set — tens of megabytes of 720p PNG, and re-derivable
# from it rather than needed by any gate. The held-out JPEGs in calib/*/frames/ and
# the calibration YAML are small and ARE committed.
calib/**/*.tar.gz

# calibrate.sh rotates the old frame set aside before a fresh grab, so a *.prev
# directory is a backup this workspace made for itself, not a calibration. One
# was committed by accident and sat superseded — nothing reads `.prev`.
calib/**/frames.prev/

# recorded data and output
bags/
captures/
meshes/
maps/
*.ply
*.db3

# python bytecode — tools/ has importable modules now (calib_straightness.py),
# so running them or the tests that import them leaves these behind
__pycache__/
*.pyc

# editor / OS
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
.cache/
compile_commands.json
*.swp
.DS_Store
