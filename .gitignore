# colcon
build/
install/
log/

# model weights — fetched, not committed (see docs/info/setup.md)
models/
*.onnx
*.engine

# recorded data and output
bags/
captures/
meshes/
maps/
*.ply
*.db3

# editor / OS
# The workspace config IS part of the project — it encodes the system-python
# pin, the compile-database path and the task list. Only per-user state is
# ignored.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json
.cache/
compile_commands.json
*.swp
.DS_Store

# pytest bytecode for the repo tools
__pycache__/
.pytest_cache/

# The editor's interpreter pointer — `just venv` recreates it in a second.
.venv/
