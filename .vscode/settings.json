{
    // --- Python tests: the three suites in src/pimesh_bringup/test/ ----------
    //
    // /usr/bin/python3 and not .venv/bin/python, for the same reason
    // tools/build.sh passes -DPython3_EXECUTABLE=/usr/bin/python3: a
    // uv-managed interpreter is what breaks ament on this box. (The .venv here
    // is --system-site-packages over the same 3.14 and would work; naming the
    // real one is one less thing to be true.)
    "python.defaultInterpreterPath": "/usr/bin/python3",

    // The whole reason the Testing panel can see this workspace. The extension
    // does not run tests through a shell — it spawns the interpreter directly,
    // so `source install/setup.bash` never happens and test_transforms.py's
    // ament-index lookups resolve against whatever AMENT_PREFIX_PATH the
    // desktop session had, which is a different workspace or nothing at all.
    // Generated by tools/lib/vscode-env.sh, refreshed by a task on folder open.
    "python.envFile": "${workspaceFolder}/.vscode/ros.env",

    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": ["src"],
    "python.testing.cwd": "${workspaceFolder}",
    "python.testing.autoTestDiscoverOnSaveEnabled": true,

    // --- C++ tests: the fifteen gtest suites --------------------------------
    //
    // Needs the C++ TestMate extension (see .vscode/extensions.json). colcon
    // puts each suite at build/<package>/test_<name>; `strictPattern` makes a
    // file that matches and is not a test executable a loud failure rather than
    // a suite that quietly never appears.
    //
    // `envFile` is the same generated file: five of these link rcl and exit 1
    // at startup unless RMW_IMPLEMENTATION names something they can load, and
    // the ones that pull in pimesh_msgs do not start without the overlay's
    // LD_LIBRARY_PATH.
    //
    // `runTask.before` builds first — and that is not a convenience. Running a
    // stale binary against edited source is a green test for code that does not
    // exist; the incremental build costs about 1.5 s.
    "testMate.cpp.test.advancedExecutables": [
        {
            "name": "${filename}",
            "pattern": "build/*/test_*",
            "strictPattern": true,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.vscode/ros.env",
            "runTask": { "before": ["build"] }
        }
    ],

    // --- Getting around ------------------------------------------------------
    //
    // build/ and install/ are colcon's, and install/ is symlinks back into src/
    // (--symlink-install), so leaving them searchable means every hit appears
    // two or three times and "go to definition" can land in a copy.
    "search.exclude": {
        "**/build": true,
        "**/install": true,
        "**/log": true,
        "**/.venv": true,
        "**/bags": true,
        "**/models": true
    },
    "files.watcherExclude": {
        "**/build/**": true,
        "**/install/**": true,
        "**/log/**": true,
        "**/bags/**": true
    },
    "[cpp]": { "editor.tabSize": 2 },
    "[python]": { "editor.tabSize": 4 }
}
