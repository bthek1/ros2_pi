<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>pimesh_perception</name>
  <version>0.0.1</version>
  <description>
    The dev box's per-frame stages: decode the Pi's JPEG once, then keypoints
    and monocular depth off the same buffer. Every node here is a component,
    loaded into one container with intra-process comms on — the decode happens
    once and downstream stages get a pointer to it, not a copy.
  </description>
  <maintainer email="bthekkel1@gmail.com">Benedict Thekkel</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>pimesh_msgs</depend>
  <depend>libopencv-dev</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
