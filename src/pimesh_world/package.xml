<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pimesh_world</name>
  <version>0.1.0</version>
  <description>
    The map. fusion_node folds posed depth maps into a spatially hashed TSDF —
    the stage where the pipeline stops being a stream of frames and starts
    remembering — and mesh_node marches cubes over a snapshot of it to publish a
    triangle surface. Both are components in the same container as the stages
    above them, and they share the volume itself rather than a topic: it is
    hundreds of megabytes of voxels and its consumer is in the same process.
  </description>
  <maintainer email="bthekkel1@gmail.com">Benedict Thekkel</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Every entry has to exist on Jazzy as well as Lyrical: tools/gates/build.sh
       builds this whole workspace at both ends. Nothing in this package runs on
       the Pi, and it still has to compile there — the same rule pimesh_perception
       lives under, and the reason there is no GPU code in here at all.

       pimesh_perception is a dependency for three header-only helpers — Mailbox,
       percentile and the bgr8 cv::Mat view — and the edge points *down* the
       pipeline, from the stage that consumes to the stage that produces. That is
       the direction that is allowed: pimesh_camera keeps its own copies of the
       same helpers precisely because an edge from the Pi's package to a dev-box
       one would point the other way. -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>pimesh_msgs</depend>
  <depend>pimesh_perception</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>libopencv-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
