<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pimesh_camera</name>
  <version>0.1.0</version>
  <description>
    Capture, and nothing else. A V4L2 MJPEG node that puts the camera's own
    JPEG bytes on the wire stamped with the kernel's capture time, plus the
    subscriber the capture gate measures that stream with. This is the only
    package that runs on the Pi in normal operation.
  </description>
  <maintainer email="bthekkel1@gmail.com">Benedict Thekkel</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- This is the Pi's package, so this list is the one that matters most in
       the workspace: every entry must exist on Jazzy, and the set is kept as
       small as it can be. Notably absent is image_transport — there is no raw
       image here for it to have an opinion about, the /compressed suffix is a
       naming convention we can simply follow, and a dependency that only earns
       its keep on the dev box has no business on the sensor head. V4L2 itself
       needs no package: <linux/videodev2.h> is kernel UAPI, shipped with libc. -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>

  <!-- P9's two additions, and they were chosen to be the ones that need
       installing on *neither* machine. The obvious candidate was
       camera_info_manager, which is what a ROS driver normally uses to load a
       calibration; it was rejected for two reasons. It is absent on the dev box
       under Lyrical, so it would have made this package's build depend on an
       apt install on the machine that never runs it. And CameraInfoManager
       advertises a `set_camera_info` service from its constructor — a service
       this node deliberately does not offer, which would let anything on the
       domain rewrite a running camera's intrinsics on disk. Reading the same
       standard YAML with yaml-cpp costs ~150 lines, is unit-testable without a
       camera, and adds no service. Both of these are already installed on both
       machines. -->
  <depend>ament_index_cpp</depend>
  <depend>yaml-cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
