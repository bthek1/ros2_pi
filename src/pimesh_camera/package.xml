<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>pimesh_camera</name>
  <version>0.0.1</version>
  <description>
    The sensor head: V4L2 MJPEG capture on the Raspberry Pi, published verbatim
    with capture-time stamps. No decode, no re-encode, no processing — every
    expensive stage of this pipeline runs on the dev box.
  </description>
  <maintainer email="bthekkel1@gmail.com">Benedict Thekkel</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>pimesh_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
