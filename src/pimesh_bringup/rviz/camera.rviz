# Milestone A's viewer: is the camera alive, and is the frame tree real.
#
# This is a *viewer*, not evidence. tools/gates/capture.sh is what passes or
# fails P1 — and note that the rate it measures has to be taken with this window
# closed, because RViz is a second RELIABLE subscriber on the one topic that
# crosses Wi-Fi, and the whole architecture is arranged around there being one.
# It is tolerable here only because a compressed frame is ~86 kB.
#
# Two displays, both on topics P0 and P1 already publish. The view layer adds no
# topics, so it adds no scope to either phase.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Image1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 500
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Alpha: 0.5
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true

    # The Pi is capturing and the LAN hop works.
    #
    # **The topic is the full name, suffix included.** RViz's Image display does
    # not take a base name plus a transport: it infers the transport *from the
    # topic name* (rviz_default_plugins/displays/image/get_transport_from_topic.cpp),
    # so `/image_raw/compressed` gives it transport `compressed` and the JPEG is
    # decoded here. There is no "Transport Hint" property on this display — the
    # only transport hints in the plugin library belong to DepthCloud ("Color
    # Transport Hint", "Depth Map Transport Hint").
    #
    # This was wrong in the first version of this file, and the way it was wrong
    # is the lesson: `Topic.Value: /image_raw` with a `Transport Hint:
    # compressed` key beside it. RViz silently ignores an unknown key, infers
    # `raw` from the name, and subscribes to `/image_raw` — which nothing
    # publishes. Measured 2026-09-09: `ros2 topic info -v
    # /image_raw/compressed` reported **Subscription count: 0** with RViz open
    # and the camera streaming at 59 Hz. The panel is then grey, and nothing in
    # it, in the log, or in the display's status says the topic does not exist.
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        # BEST_EFFORT, deliberately, against a RELIABLE publisher.
        #
        # That pairing is legal and is not a mismatch: reliability is a
        # request-offered property, and a RELIABLE writer satisfies a
        # BEST_EFFORT reader. (The reverse is the incompatible one, and it fails
        # the way QoS mismatches always do here — the subscription never
        # connects, RViz shows a grey panel and says nothing.)
        #
        # It is BEST_EFFORT because a RELIABLE reader delivers samples *in
        # sequence*, so one lost fragment blocks every frame behind it until the
        # loss is resolved by a heartbeat round trip. On this Wi-Fi link that is
        # a visible freeze-then-catch-up several times a minute. Measured
        # 2026-09-09, same writer and same session, only the reader's QoS
        # changed, 20 s windows of ~1100 frames each:
        #
        #   RELIABLE reader     10 gaps over 50 ms, worst 490 ms, p99 36.2 ms
        #   BEST_EFFORT reader   3 gaps over 50 ms, worst 181 ms, p99 27.4 ms
        #
        # A dropped frame in a live view costs nothing; a half-second stall is
        # the thing that looks broken. The residue is Wi-Fi loss bursts and is
        # not fixed by QoS.
        #
        # **This does not overturn the project's BEST_EFFORT rule.** That rule
        # is about megabyte-class *raw* images — 2.7 MB is ~1900 fragments, and
        # losing one of those on every frame means delivering none. These frames
        # are ~80 kB, about 56 fragments, and 1097 of them arrived intact with
        # 0 undecodable. Size is the whole difference; do not carry this over to
        # a raw image topic.
        Reliability Policy: Best Effort
        Value: /image_raw/compressed
      Value: true

    # The static tree from P0 is present and rigid.
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Frame Timeout: 15
      Marker Scale: 0.3
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    # base_link, not map: this milestone publishes map -> odom as a static
    # identity placeholder, and fixing the view to a frame that is standing in
    # for something makes the placeholder easy to forget. base_link is the
    # frame the camera is actually rigid to.
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Focal Point: {X: 0, Y: 0, Z: 0}
      Name: Current View
      Pitch: 0.4
      Target Frame: <Fixed Frame>
      Yaw: 2.5
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Width: 1280
  Image:
    collapsed: false
